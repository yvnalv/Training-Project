# ============================================================
# VialVision — .gitignore
# ============================================================

# ── Database & results ───────────────────────────────────────
data/vialvision.db
data/vialvision.db-shm
data/results/
# Keep the data/ folder structure but not its contents
!data/.gitkeep

# ── YOLOv8 model weights ─────────────────────────────────────
*.pt
*.onnx
*.torchscript
*.engine          # TensorRT compiled models

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ─────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Environment variables ────────────────────────────────────
.env
.env.*
!.env.example

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# ── Editors ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Pytest / coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
# ── Training artifacts (machine-specific; copy weights manually) ──
training/data.vialvision.yaml
training/*.log
runs/
# Ignore the models dir EXCEPT the deployed weights (baked into the Docker image
# by CI — kept in git so builds are reproducible). NCNN dir stays out (Pi-only).
models/*
!models/vialvision_yolo26.pt
test_images/*_annotated.jpg
test_images/*_OLDMODEL.jpg
test_images/*_RACKMODEL.jpg
